PORT=5000
# Paste your MongoDB Atlas Connection String below:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leaveease?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Optional: Nodemailer SMTP Configuration for email notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
